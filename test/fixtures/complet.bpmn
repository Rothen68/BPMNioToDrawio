<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_complet" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_Client" name="Client" processRef="Process_Client" />
    <bpmn:participant id="Pool_Fournisseur" name="Fournisseur" />
    <bpmn:participant id="Pool_Catalogue" name="Catalogue de formes" processRef="Process_Catalogue" />
    <bpmn:messageFlow id="MsgFlow_Commande" name="Bon de commande" sourceRef="Task_Commander" targetRef="Pool_Fournisseur" />
    <bpmn:messageFlow id="MsgFlow_Confirmation" sourceRef="Pool_Fournisseur" targetRef="Start_Commande" />
    <bpmn:textAnnotation id="Annotation_Delai">
      <bpmn:text>Délai max :
48 h</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Delai" associationDirection="None" sourceRef="Annotation_Delai" targetRef="End_Termine" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Client" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Client">
      <bpmn:lane id="Lane_Accueil" name="Accueil">
        <bpmn:flowNodeRef>Start_Commande</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Verifier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Commander</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notifier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Termine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Timer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Back" name="Back-office">
        <bpmn:flowNodeRef>Throw_Escalade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Refusee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Preparer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Commande" name="Commande reçue">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_1" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Verifier" name="Vérifier la commande">
      <bpmn:documentation>Contrôler le stock et le client.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:property id="Property_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataIn_1">
        <bpmn:sourceRef>DataRef_Commande</bpmn:sourceRef>
        <bpmn:targetRef>Property_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_Timer" name="24 h" cancelActivity="false" attachedToRef="Task_Verifier">
      <bpmn:outgoing>Flow_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_1" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Throw_Escalade" name="Escalader">
      <bpmn:incoming>Flow_Timer</bpmn:incoming>
      <bpmn:escalationEventDefinition id="EED_1" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_OK" name="OK ?" default="Flow_Non">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Oui</bpmn:outgoing>
      <bpmn:outgoing>Flow_Non</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Refusee" name="Refusée">
      <bpmn:incoming>Flow_Non</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerED_1" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Commander" name="Commander">
      <bpmn:incoming>Flow_Oui</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_Split">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="Task_Notifier" name="Notifier le client">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:subProcess id="Sub_Preparer" name="Préparer">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:startEvent id="Sub_Start">
        <bpmn:outgoing>Sub_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:scriptTask id="Sub_Calculer" name="Calculer">
        <bpmn:incoming>Sub_Flow_1</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_2</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics />
      </bpmn:scriptTask>
      <bpmn:endEvent id="Sub_End">
        <bpmn:incoming>Sub_Flow_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Sub_Flow_1" sourceRef="Sub_Start" targetRef="Sub_Calculer" />
      <bpmn:sequenceFlow id="Sub_Flow_2" sourceRef="Sub_Calculer" targetRef="Sub_End" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="Gateway_Join">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_Termine" name="Terminé">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_2" />
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataRef_Commande" name="Commande" dataObjectRef="DataObject_1" />
    <bpmn:dataObject id="DataObject_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Commande" targetRef="Task_Verifier" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Verifier" targetRef="Gateway_OK" />
    <bpmn:sequenceFlow id="Flow_Oui" name="oui" sourceRef="Gateway_OK" targetRef="Task_Commander" />
    <bpmn:sequenceFlow id="Flow_Non" name="non" sourceRef="Gateway_OK" targetRef="End_Refusee" />
    <bpmn:sequenceFlow id="Flow_Timer" sourceRef="Boundary_Timer" targetRef="Throw_Escalade" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Commander" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Split" targetRef="Task_Notifier" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Split" targetRef="Sub_Preparer" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Notifier" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Sub_Preparer" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Join" targetRef="End_Termine" />
    <bpmn:group id="Group_Controle" categoryValueRef="CategoryValue_1" />
  </bpmn:process>
  <bpmn:category id="Category_1">
    <bpmn:categoryValue id="CategoryValue_1" value="Contrôle" />
  </bpmn:category>
  <bpmn:process id="Process_Catalogue" isExecutable="false">
    <bpmn:inclusiveGateway id="Cat_Inclusive" name="Inclusive" />
