    <bpmn:businessRuleTask id="Cat_Rule" name="Règle métier" />
    <bpmn:manualTask id="Cat_Manual" name="Manuelle">
      <bpmn:standardLoopCharacteristics />
    </bpmn:manualTask>
    <bpmn:receiveTask id="Cat_Receive" name="Réception">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:receiveTask>
    <bpmn:intermediateCatchEvent id="Cat_Signal" name="Signal">
      <bpmn:signalEventDefinition id="SED_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="Cat_Conditional" name="Condition">
      <bpmn:conditionalEventDefinition id="CED_1">
        <bpmn:condition xsi:type="bpmn:tFormalExpression" />
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="Cat_Link" name="Lien">
      <bpmn:linkEventDefinition id="LED_1" name="A" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="Cat_Error" name="Erreur">
      <bpmn:errorEventDefinition id="ErED_1" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="Cat_Store" name="Base" />
    <bpmn:subProcess id="Cat_EventSub" name="Sur délai" triggeredByEvent="true">
      <bpmn:startEvent id="Cat_EventSub_Start" isInterrupting="false">
        <bpmn:timerEventDefinition id="TED_2" />
      </bpmn:startEvent>
    </bpmn:subProcess>
  </bpmn:process>
